# ============================================================================
# my-project-management 本地运行 / 测试环境变量模板
# ============================================================================
# 用法：
#   1. cp .env.example .env
#   2. 填入真实值
#   3. python-dotenv 自动加载（或 source .env 后再跑 python 脚本）
#
# GitHub Actions 中的同名变量已在 .github/workflows/*.yml 中通过
# secrets.* / vars.* 引用，无需在此维护；本文件仅供本地开发。
# ============================================================================


# ── GitHub 认证 ──────────────────────────────────────────────────────────────

# Project v2 操作需要的 classic PAT（scope: repo + project）
# 用于：auto-deploy / weekly-update / generate_weekly_plan 等写 Project 的脚本
PROJECT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub 用户名（fork/迁移兼容；默认回退到 GITHUB_REPOSITORY_OWNER / 硬编码）
GH_OWNER=laiyinyizao007


# ── Claude / LLM API（主）─────────────────────────────────────────────────────

# Anthropic API key（必填；用于 Claude Haiku 生成 AI 内容）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude API 自定义端点（可选；用于中转 / 镜像；留空走官方 api.anthropic.com）
ANTHROPIC_BASE_URL=

# 主 LLM 模型名（可选；默认 claude-haiku-4-5-20251001）
LLM_PRIMARY_MODEL=claude-haiku-4-5-20251001


# ── LLM Fallback（备用 LLM，主 key 限流 / 失败时自动切换）─────────────────

# 备用 LLM API key（任意 Anthropic 兼容中转服务的 key）
# 未设置时无 fallback；脚本行为与 v1.17 之前一致
LLM_FALLBACK_API_KEY=

# 备用 LLM 端点（base_url）
LLM_FALLBACK_BASE_URL=

# 备用 LLM 模型名（默认 MiniMax-M3）
LLM_FALLBACK_MODEL=MiniMax-M3


# ── Project v2 看板（管理仓库默认配置）────────────────────────────────────

# Project v2 编号（默认 1）
PROJECT_NUMBER=1

# project-url 路径前缀：users（个人）或 orgs（组织）
# 仅在迁移到 Org 时改为 orgs
PROJECT_OWNER_TYPE=users

# Profile README 仓库路径（默认 <owner>/<owner>，如 laiyinyizao007/laiyinyizao007）
PROFILE_REPO=


# ── 本地代理（可选）───────────────────────────────────────────────────────────

# 本地运行时若需走代理（GitHub Actions 不需要）
HTTP_PROXY=
HTTPS_PROXY=